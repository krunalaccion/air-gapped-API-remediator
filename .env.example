# Git SubAgent Environment Configuration Example

# Repository settings
GIT_REPO_URL=https://github.com/your-org/your-repo.git

# Authentication Tokens
# For GitHub (Classic PAT or Fine-Grained Personal Access Token with repo/pull_request permissions)
GITHUB_TOKEN=ghp_exampleToken1234567890abcdef

# For GitLab (Personal Access Token or Project Access Token with api, read_repository, write_repository)
# GITLAB_TOKEN=glpat-exampleToken1234567890

# Optional: Universal fallback token
# GIT_AGENT_TOKEN=your-token-here

# Optional: Self-hosted GitLab / GitHub Enterprise API endpoints
# GITHUB_API_BASE=https://ghe.mycorp.com/api/v3
# GITLAB_API_BASE=https://gitlab.mycorp.com/api/v4

# Branch Defaults
BASE_BRANCH=main
FEATURE_BRANCH_PREFIX=agent/vuln-audit-

# Author Details for Git Commits
GIT_AUTHOR_NAME=Vulnerability Fix Agent
GIT_AUTHOR_EMAIL=vuln-agent@company.local

